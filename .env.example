# -----------------------------------------------------------------------------
# Authentification Aquasys -> Serverless Function
# -----------------------------------------------------------------------------
# Recommandé : stocker les clés en secret Scaleway, pas en variable non secrète.
AQUASYS_API_KEYS=change-me-client-key-1,change-me-client-key-2
# Alternative plus sûre : SHA-256 hex des clés Aquasys, séparés par virgules.
# AQUASYS_API_KEY_SHA256_HASHES=7f0f...,...
AQUASYS_AUTH_HEADER=X-API-Key
# Valeurs possibles : header, bearer
AQUASYS_AUTH_MODE=header

# -----------------------------------------------------------------------------
# API Willie amont
# -----------------------------------------------------------------------------
# À régler selon la documentation Willie : https://docs.meetwillie.com/
WILLIE_API_BASE_URL=https://api.meetwillie.com
WILLIE_API_TOKEN=change-me-willie-token
# Valeurs possibles : bearer, x-api-key, header, query, none
WILLIE_TOKEN_MODE=bearer
# Utilisé si WILLIE_TOKEN_MODE=header ou x-api-key
WILLIE_TOKEN_HEADER=X-API-Key
# Utilisé si WILLIE_TOKEN_MODE=query
WILLIE_TOKEN_QUERY_PARAM=token
# Utilisé si WILLIE_TOKEN_MODE=header ; ${token} est remplacé par WILLIE_API_TOKEN
WILLIE_TOKEN_HEADER_VALUE_TEMPLATE=${token}

# -----------------------------------------------------------------------------
# Compteurs autorisés
# -----------------------------------------------------------------------------
# Liste définie « en dur » via variable d'environnement Scaleway.
ALLOWED_METER_IDS=meter-001,meter-002,meter-003

# Champs JSON qui identifient un compteur dans les réponses Willie.
# À adapter aux schémas Willie constatés dans les endpoints utilisés.
METER_ID_KEYS=meterId,meter_id,waterMeterId,water_meter_id,counterId,counter_id,deviceId,device_id
# Chemins JSON complémentaires, utiles si la réponse contient { meter: { id: "..." } }.
METER_ID_JSON_PATHS=meter.id,counter.id,device.id,waterMeter.id

# Paramètres query côté client qui peuvent contenir des IDs compteurs.
CLIENT_METER_QUERY_PARAMS=meterId,meter_id,meterIds,meter_ids,counterId,counter_id,deviceId,device_id

# Si l'API Willie sait filtrer en query, définis le nom attendu ici.
# La fonction injectera la liste autorisée si Aquasys ne fournit pas de filtre.
# Exemples possibles selon doc Willie : meter_ids, meterIds, counter_ids, device_ids...
UPSTREAM_METER_QUERY_PARAM=
# csv => meter_ids=a,b ; repeat => meter_ids=a&meter_ids=b
UPSTREAM_METER_QUERY_STYLE=csv

# -----------------------------------------------------------------------------
# Routes amont explicitement autorisées
# -----------------------------------------------------------------------------
# Regex séparées par ; , ou nouvelles lignes. Ancrer les regex est recommandé.
# À adapter aux endpoints Willie réellement utilisés.
# Exemples : ^/v1/meters/?$ ; ^/v1/meters/[^/]+/readings/?$ ; ^/v1/readings/?$
ALLOWED_UPSTREAM_PATHS=^/v1/meters/?$,^/v1/meters/[^/]+/readings/?$,^/v1/readings/?$

# Optionnel : regex avec un groupe capturant l'ID compteur dans le path.
# Toute valeur capturée devra appartenir à ALLOWED_METER_IDS.
# Exemple : ^/v1/meters/([^/]+)/readings/?$
UPSTREAM_PATH_METER_ID_REGEXES=^/v1/meters/([^/]+)/readings/?$

# GET uniquement par défaut ; éviter POST/PUT tant que Willie n'en a pas besoin.
ALLOWED_METHODS=GET,HEAD,OPTIONS

# Optionnel : base path public à retirer avant appel Willie.
# Exemple si l'URL publique est /aquasys/v1/readings et l'endpoint Willie /v1/readings.
PUBLIC_BASE_PATH=

# Optionnel : whitelist stricte des paramètres query relayés vers Willie.
# Vide = tous les paramètres sont relayés sauf ceux bloqués ci-dessous.
ALLOWED_QUERY_PARAMS=
BLOCKED_QUERY_PARAMS=api_key,key,token,access_token,auth,authorization

# -----------------------------------------------------------------------------
# Sécurité, limites, timeouts
# -----------------------------------------------------------------------------
UPSTREAM_TIMEOUT_MS=10000
MAX_REQUEST_BYTES=65536
MAX_RESPONSE_BYTES=5242880
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# fail = si aucun ID compteur n'est trouvé dans une réponse JSON, on refuse de la relayer.
# pass = on relaie quand même. Recommandé : fail sauf endpoint déjà filtré côté Willie.
FILTER_ON_MISSING_METER_ID=fail
ALLOW_NON_JSON_RESPONSES=false

# CORS : vide = désactivé. Mettre les origines exactes si appel depuis navigateur.
CORS_ALLOWED_ORIGINS=

# À n'utiliser qu'en local pour tester contre http://localhost.
ALLOW_INSECURE_UPSTREAM=false
LOG_LEVEL=info
